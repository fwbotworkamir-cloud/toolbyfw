[Unit]
Description=Discover Analyzer collection scheduler
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/discover-analyzer
ExecStart=/usr/bin/node /root/discover-analyzer/src/cli.js master
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=HOME=/root

[Install]
WantedBy=multi-user.target
